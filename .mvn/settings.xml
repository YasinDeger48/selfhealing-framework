<?xml version="1.0" encoding="UTF-8"?>
<!-- Project-local Maven settings: resolves from Maven Central directly.
     Used because the corporate mirror in the user settings is only reachable on VPN.
     Delete .mvn/maven.config to go back to the global settings. -->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">
  <mirrors>
    <mirror>
      <id>central-direct</id>
      <url>https://repo.maven.apache.org/maven2</url>
      <mirrorOf>*</mirrorOf>
    </mirror>
  </mirrors>
</settings>
