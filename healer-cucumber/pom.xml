<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.yasindeger48</groupId>
    <artifactId>healer-parent</artifactId>
    <version>2.2.0</version>
  </parent>
  <artifactId>healer-cucumber</artifactId>
  <name>Healer Cucumber</name>
  <description>Cucumber plugin: reports with Gherkin steps, WARN blocks and failure analysis for healer-playwright or healer-selenium.</description>

  <dependencies>
    <dependency>
      <groupId>io.github.yasindeger48</groupId>
      <artifactId>healer-core</artifactId>
    </dependency>
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-plugin</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.yasindeger48</groupId>
      <artifactId>healer-playwright</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-java</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <!-- the tests drive a real browser through healer-playwright (installed Edge; -Dbrowser.channel=chromium in CI) -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>-Dfile.encoding=UTF-8 -Dsun.stdout.encoding=UTF-8</argLine>
          <systemPropertyVariables>
            <healer.llm.enabled>false</healer.llm.enabled>
            <healer.report.pdf>false</healer.report.pdf>
            <healer.verbose>false</healer.verbose>
            <healer.probeTimeoutMs>600</healer.probeTimeoutMs>
          </systemPropertyVariables>
          <environmentVariables>
            <PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD>1</PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD>
          </environmentVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
