<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.yasindeger48</groupId>
    <artifactId>healer-parent</artifactId>
    <version>2.1.0</version>
  </parent>
  <artifactId>healer-testng</artifactId>
  <name>Healer TestNG</name>
  <description>TestNG listener: reports, WARN blocks and failure analysis for healer-playwright or healer-selenium tests.</description>

  <dependencies>
    <dependency>
      <groupId>io.github.yasindeger48</groupId>
      <artifactId>healer-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.testng</groupId>
      <artifactId>testng</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.yasindeger48</groupId>
      <artifactId>healer-playwright</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- same JUnit Platform version as the engine (the forced surefire provider would bring an older launcher) -->
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <!-- the tests drive a real browser through healer-playwright (installed Edge; -Dbrowser.channel=chromium in CI) -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <dependencies>
          <!-- the module's own tests are JUnit tests that run TestNG programmatically -->
          <dependency>
            <groupId>org.apache.maven.surefire</groupId>
            <artifactId>surefire-junit-platform</artifactId>
            <version>3.6.0</version>
          </dependency>
        </dependencies>
        <configuration>
          <argLine>-Dfile.encoding=UTF-8 -Dsun.stdout.encoding=UTF-8</argLine>
          <systemPropertyVariables>
            <healer.llm.enabled>false</healer.llm.enabled>
            <healer.report.pdf>false</healer.report.pdf>
            <healer.verbose>false</healer.verbose>
            <healer.probeTimeoutMs>600</healer.probeTimeoutMs>
            <!-- set before anything runs: Surefire 3.6 starts TestNG for discovery, which already loads the healer config -->
            <healer.storeDir>target/testng-store</healer.storeDir>
            <healer.reportDir>target/testng-report</healer.reportDir>
          </systemPropertyVariables>
          <environmentVariables>
            <PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD>1</PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD>
          </environmentVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
